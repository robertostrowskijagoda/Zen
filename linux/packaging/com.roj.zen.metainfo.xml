<!-- AppStream metadata (software centres, Flatpak). Installed by the .deb
     to /usr/share/metainfo; the id matches APPLICATION_ID in
     linux/CMakeLists.txt and the .desktop file name. -->
<component type="desktop-application">
  <id>com.roj.zen</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- GPL-3.0-only with additional terms under its section 7 (NOTICE). -->
  <project_license>GPL-3.0-only</project_license>
  <name>Zen</name>
  <summary>A network of people who know each other</summary>
  <summary xml:lang="pl">Sieć ludzi, którzy się znają</summary>
  <developer id="io.github.robertostrowskijagoda">
    <name>Robert Ostrowski-Jagoda</name>
  </developer>
  <description>
    <p>
      Zen connects you with people you know, directly and without servers,
      ads or an algorithm. Messages, calls and posts travel between your
      friends' devices over an encrypted mesh network.
    </p>
    <p xml:lang="pl">
      Zen łączy Cię z ludźmi, których znasz — bezpośrednio, bez serwerów,
      reklam i algorytmu. Wiadomości, rozmowy i wpisy płyną między
      urządzeniami znajomych przez szyfrowaną sieć.
    </p>
  </description>
  <launchable type="desktop-id">com.roj.zen.desktop</launchable>
  <url type="homepage">https://robertostrowskijagoda.github.io/Zen/</url>
  <url type="vcs-browser">https://github.com/robertostrowskijagoda/Zen</url>
  <url type="bugtracker">https://github.com/robertostrowskijagoda/Zen/issues</url>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <provides>
    <binary>zen</binary>
    <mediatype>x-scheme-handler/zen</mediatype>
  </provides>
  <content_rating type="oars-1.1">
