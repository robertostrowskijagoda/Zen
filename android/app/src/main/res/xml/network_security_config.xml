<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this phone itself: the film stream server
     (lib/src/features/media/media_stream_server.dart) hands encrypted films
     to the system player on 127.0.0.1 while they download. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
