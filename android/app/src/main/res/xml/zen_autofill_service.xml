<?xml version="1.0" encoding="utf-8"?>
<!-- Zen's autofill service (ZenAutofillService.kt). No settings page.

     The browsers below hand no form to an autofill service themselves, so
     Android serves them in its compatibility mode: it builds the form from
     the browser's accessibility tree and takes the page's address from the
     address bar's text. Android does so only for a package that is also on
     its own list of allowed ones (the global setting
     autofill_compat_mode_allowed_packages, which also names the bar's id).
     The same packages, with the bar's ids, are compatibilityBrowsers in
     ZenAutofillTrust.kt; each has a confirmed maker's key there, so a copy
     signed by someone else is filled like any other app.

     maxLongVersionCode: compatibility mode is used up to that version of
     the browser and the browser's own support after it. None of these has a
     version that hands forms to the service itself, so the limit is beyond
     any version code they use (as Bitwarden sets it). A browser that gains
     its own support gets its last version without it here. An entry Android
     cannot read ends the list, so each has both attributes. -->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android">
    <compatibility-package
        android:name="com.sec.android.app.sbrowser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.sec.android.app.sbrowser.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.microsoft.emmx"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.microsoft.emmx.beta"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.microsoft.emmx.dev"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.microsoft.emmx.canary"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.browser"
        android:maxLongVersionCode="10000000000" />
    <compatibility-package
        android:name="com.opera.browser.beta"
        android:maxLongVersionCode="10000000000" />
</autofill-service>
