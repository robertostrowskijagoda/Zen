<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incoming_call_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incoming_call_scrim"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/incoming_call_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/incoming_call_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/incoming_call_badge"
            android:letterSpacing="0.12"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="POŁĄCZENIE AUDIO"
            android:textAllCaps="true"
            android:textColor="@color/incoming_call_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/incoming_call_avatar">

            <ImageView
                android:id="@+id/incoming_call_avatar_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_call"
                android:tint="@color/incoming_call_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/incoming_call_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/incoming_call_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incoming_call_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/incoming_call_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/incoming_call_decline"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:background="@drawable/incoming_call_decline"
                android:stateListAnimator="@null"
                android:text="Odrzuć"
                android:textAllCaps="false"
                android:textColor="@color/incoming_call_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/incoming_call_accept"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/incoming_call_accept"
                android:stateListAnimator="@null"
                android:text="Odbierz"
                android:textAllCaps="false"
                android:textColor="@color/incoming_call_on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
