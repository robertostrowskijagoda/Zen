<?xml version="1.0" encoding="utf-8"?>
<!-- The "appStoreOnly" flavor (Google Play, Galaxy Store; STAN D12), merged
     over src/main/AndroidManifest.xml. Stores update the app themselves and
     do not allow it to install APKs: the permission is removed, and Dart
     hides self-update and APK sharing
     (lib/src/features/update/store_build.dart). The launcher label stays
     "Zen" as in every build; only the About screen says "Wersja ze sklepu"
     (and the output files are named APP-STORE-ONLY-do-not-install-manually).
     The look-alike "Notatki" launcher alias is removed: a disguised icon is
     deceptive under the store policies. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <activity-alias
            android:name=".LauncherDisguise"
            tools:node="remove" />
    </application>
</manifest>
