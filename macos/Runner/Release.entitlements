<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Zen is not sandboxed: it runs system tools (route for the router's port
  mapping, adb for "Podaj dalej" over USB, open for links), and the release
  is signed ad hoc, so every update would be a stranger to the sandbox
  container the previous build left behind. The other keys are the hardened
  runtime's resource access (calls, voice messages, the alarm's location),
  needed once the app is signed with a Developer ID and notarized.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
