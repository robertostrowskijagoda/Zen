<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Films play while they download from the app's own loopback server: plain HTTP is allowed for 127.0.0.1 only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Zen's own files open in Zen (a backup, a key backup, an update:
	     opened_files.dart); the types are declared below. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zen account backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.roj.zen.backup</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zen key backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.roj.zen.key</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zen update</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.roj.zen.update</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pl</string>
		<string>id</string>
		<string>cs</string>
		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>it</string>
		<string>hu</string>
		<string>nl</string>
		<string>pt</string>
		<string>ro</string>
		<string>vi</string>
		<string>tr</string>
		<string>ru</string>
		<string>uk</string>
		<string>ar</string>
		<string>hi</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.roj.zen</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zen</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Zen uses Bluetooth to connect directly to your friends’ devices nearby when there is no internet.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_zen-link._tcp</string>
		<string>_zen-link._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Zen uses the camera for video calls.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Zen saves to Downloads only what you tell it to save, for example a new version of the app.</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Zen connects directly to your friends’ devices, including on the same Wi-Fi network, without any server.</string>
	<key>NSLocationUsageDescription</key>
	<string>Zen asks for your location only when you choose to send it to someone, for example in an alert or when meeting up.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Zen asks for your location only when you choose to send it to someone, for example in an alert or when meeting up.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Zen uses the microphone for voice and video calls and for recording voice messages.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Zen account backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.roj.zen.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zenbackup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Zen key backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.roj.zen.key</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zenkey</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Zen update</string>
			<key>UTTypeIdentifier</key>
			<string>com.roj.zen.update</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zenupdate</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
